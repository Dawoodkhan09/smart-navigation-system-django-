{% load static %}{
    "name": "Campus Guide",
    "short_name": "Campus",
    "description": "Scan a campus QR code and get walking directions.",
    "display": "standalone",
    "orientation": "portrait",
    "start_url": "/app/",
    "scope": "/",
    "theme_color": "#0E7C66",
    "background_color": "#FBFAF7",
    "icons": [
        {
            "src": "{% static 'campus/img/icon-192.png' %}",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "any maskable"
        },
        {
            "src": "{% static 'campus/img/icon-512.png' %}",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any maskable"
        }
    ]
}
